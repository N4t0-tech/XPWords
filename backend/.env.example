# PostgreSQL (Railway lo provee automáticamente)
DATASOURCE_URL=jdbc:postgresql://host:port/railway
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=password

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=tu_client_id
DISCORD_CLIENT_SECRET=tu_client_secret

# JWT (generar con: openssl rand -base64 64)
JWT_SECRET=tu_secreto_jwt

# URLs de la app (Railway provee las URLs automáticamente)
FRONTEND_URL=https://tudominio.railway.app
BACKEND_URL=https://tubackend.railway.app
